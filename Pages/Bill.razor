@if (Bills == null || Bills.Count == 0)
{
    <div class="text-center mb-3">
        No Record</div>
}

<div style="display: flex; gap: 10px;">
    <InputText @bind-Value="VendorId" placeholder="Vendor" class="form-control" />
    <InputNumber @bind-Value="TotalAmount" placeholder="Total Amount" class="form-control" />
</div>

<br />
<div class="text-center">
    <button class="btn btn-primary me-2" @onclick="AddFlow">Add Bill</button>
    @* <button class="btn btn-primary me-2" @onclick="AddMinusFlow">Minus Cash -</button> *@
</div>
<div class="text-center">
    <br>
    <button class="btn btn-success" @onclick="DeleteLastFlow">Delete Last</button>
</div>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning mt-3">@errorMessage</div>
}

@code {

    private string? VendorId = "";
    private DateTime? BillDate; // | DATETIME | Tanggal invoice dibuat |
    private DateTime? DueDate;
    private decimal TotalAmount;
    private string? Status = "";//| Status | VARCHAR(50) | Status invoice (e.g. Pending, Paid, Overdue) |

    @* private string? email; *@

    private string? errorMessage;
    List<Bills> Bills = new List<Bills>();

    protected override async Task OnInitializedAsync()
    {
        // Code to run when component initializes (sync)
        @* LoadData(); *@
        await GetAllBill();
    }

    // Or async version
    @* protected override async Task OnInitializedAsync()
{
await LoadDataAsync();
} *@


    private async Task AddFlow()
    {
        if (string.IsNullOrWhiteSpace(VendorId) || TotalAmount == 0)
        {
            @* await JS.InvokeVoidAsync("alert", "Please complete form"); *@
            errorMessage = "⚠️ Please complete the form.";
            return;
        }
        TotalAmount = Math.Abs(TotalAmount);

        errorMessage = null;


        var newInvoice = new Bills
        {
            VendorId = VendorId,
            BillDate = DateTime.Now, // | DATETIME | Tanggal invoice dibuat |
            DueDate = null,
            TotalAmount = TotalAmount,
            Status = "Pending",
            CreatedAt = DateTime.Now,
        };

        IMagicQuery<Bills> query = await _MagicDb.Query<Bills>();
        await query.AddAsync(newInvoice);


        IEnumerable<JournalLines> journalLinesMulti = new List<JournalLines>
{
new JournalLines
{
JournalDescription = "Bill-"+VendorId,
JournalEntryId=null,
AccountId=5,
AccountType = AccountType.Expense,
Debit = TotalAmount,
Credit = null,
Description ="Beban / Persediaan",
},
new JournalLines
{
JournalDescription = "Bill-"+VendorId,
JournalEntryId=null,
AccountId=2,
AccountType = AccountType.Liability,
Debit = null,
Credit = TotalAmount,
Description ="Hutang Usaha",
}
};

        IMagicQuery<JournalLines> journalQuery = await _MagicDb.Query<JournalLines>();
        await journalQuery.UpdateRangeAsync(journalLinesMulti);

        VendorId = null;
        TotalAmount = 0;
        await GetAllBill();
    }



    private async Task GetAllBill()
    {

        IMagicQuery<Bills> Query = await _MagicDb.Query<Bills>();
        var flowList = await Query.ToListAsync();
        Bills = flowList;
        @* Console.WriteLine("personQuery:"); *@
        foreach (var flow in flowList)
        {
            @* Console.WriteLine($"Id: {person.Id}, Name: {person.Name}, Age: {person.Age}"); *@
            @* string json = JsonSerializer.Serialize(person);
Console.WriteLine(json); // This requires Client class to have a proper ToString() override *@
        }

    }

    private async Task DeleteLastFlow()
    {
        IMagicQuery<Bills> query = await _MagicDb.Query<Bills>();

        // Get all flows fresh from DB
        var allFlows = await query.ToListAsync();

        var lastItem = allFlows.LastOrDefault();

        if (lastItem?.Status == "Paid")
        {
            return;
        }

        if (lastItem != null)
        {
            await query.DeleteAsync(lastItem);
        }

        await GetAllBill(); // Refresh your UI list
    }

    private async Task Pay(Bills item)
    {
        @* Logic to handle payment for the selected bill *@
        // For example, you might want to navigate to a payment page or open a payment dialog
        @* await JS.InvokeVoidAsync("alert", $"Initiating payment for Bill ID: {item.Id}"); *@

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to pay: {item.VendorId}?");
        if (confirmed)
        {
            // Proceed with payment logic
            @* await JS.InvokeVoidAsync("alert", $"Initiating payment for Bill ID: {item.Id}"); *@
            // make payment record
            Payments? newPayment = new Payments
            {
                PaymentMethod = "Bill Payment",
                PaymentDate = DateTime.Now, // | DATETIME | Tanggal Payment dibuat |
                Amount = item.TotalAmount ?? 0,
                InvoiceId = null,
                BillId = item.Id.ToString(),
                CreatedAt = DateTime.Now,
            };
            IMagicQuery<Payments> paymentQuery = await _MagicDb.Query<Payments>();
            await paymentQuery.AddAsync(newPayment);
            // change bill status to Paid
            IMagicQuery<Bills> billQuery = await _MagicDb.Query<Bills>();
            item.Status = "Paid";
            await billQuery.UpdateAsync(item);


            //journal
            IEnumerable<JournalLines> journalLinesMulti = new List<JournalLines>
{
new JournalLines
{
JournalDescription = "Payment-Bill-"+item.VendorId,
JournalEntryId=null,
AccountId=2,
AccountType = AccountType.Liability,
Debit = item.TotalAmount,
Credit = null,
Description ="Hutang Usaha",
},
new JournalLines
{
JournalDescription = "Payment-Bill-"+item.VendorId,
JournalEntryId=null,
AccountId=1,
AccountType = AccountType.Asset,
Debit = null,
Credit = item.TotalAmount,
Description ="Kas / Bank",
}
};

            IMagicQuery<JournalLines> journalQuery = await _MagicDb.Query<JournalLines>();
            await journalQuery.UpdateRangeAsync(journalLinesMulti);


            await GetAllBill();

        }
        else
        {
            // Optional: handle cancellation
            @* await JS.InvokeVoidAsync("alert", "Payment cancelled."); *@
        }

    }


    @* = new()
{
new Invoice { TransactionDate = DateTime.Now.AddDays(-3), Description = "Sale", CashInflow = 1000m, CashOutflow = 0m },
new Invoice { TransactionDate = DateTime.Now.AddDays(-2), Description = "Rent", CashInflow = 0m, CashOutflow = 500m },
new Invoice { TransactionDate = DateTime.Now.AddDays(-1), Description = "Loan", CashInflow = 2000m, CashOutflow = 0m },
}; *@


}