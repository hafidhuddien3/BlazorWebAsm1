<div style="display: flex; gap: 10px;">
    <InputText @bind-Value="VendorId" placeholder="Vendor" class="form-control" />
    <InputNumber @bind-Value="TotalAmount" placeholder="Total Amount" class="form-control" />
</div>

<br />
<div class="text-center">
    <button class="btn btn-primary me-2" @onclick="AddFlow">Add Bill</button>
    @* <button class="btn btn-primary me-2" @onclick="AddMinusFlow">Minus Cash -</button> *@
</div>
<div class="text-center">
    <br>
    <button class="btn btn-success" @onclick="DeleteLastFlow">Delete Last</button>
</div>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning mt-3">@errorMessage</div>
}

@code {

    private string? VendorId = "";
    private DateTime? BillDate; // | DATETIME | Tanggal invoice dibuat |
    private DateTime? DueDate;
    private decimal TotalAmount;
    private string? Status = "";//| Status | VARCHAR(50) | Status invoice (e.g. Pending, Paid, Overdue) |

    @* private string? email; *@

    private string? errorMessage;
    List<Bills> Bills = new List<Bills>();

    protected override async Task OnInitializedAsync()
    {
        // Code to run when component initializes (sync)
        @* LoadData(); *@
        await GetAllInvoice();
    }

    // Or async version
    @* protected override async Task OnInitializedAsync()
{
await LoadDataAsync();
} *@


    private async Task AddFlow()
    {
        if (string.IsNullOrWhiteSpace(VendorId) || TotalAmount == 0)
        {
            @* await JS.InvokeVoidAsync("alert", "Please complete form"); *@
            errorMessage = "⚠️ Please complete the form.";
            return;
        }
        TotalAmount = Math.Abs(TotalAmount);

        errorMessage = null;


        var newInvoice = new Bills
            {
                VendorId = VendorId,
                BillDate = DateTime.Now, // | DATETIME | Tanggal invoice dibuat |
                DueDate = null,
                TotalAmount = TotalAmount,
                Status = "Pending",
                CreatedAt = DateTime.Now,
            };

        IMagicQuery<Bills> query = await _MagicDb.Query<Bills>();
        await query.AddAsync(newInvoice);

        VendorId = null;
        TotalAmount = 0;
        await GetAllInvoice();
    }



    private async Task GetAllInvoice()
    {

        IMagicQuery<Bills> Query = await _MagicDb.Query<Bills>();
        var flowList = await Query.ToListAsync();
        Bills = flowList;
        @* Console.WriteLine("personQuery:"); *@
        foreach (var flow in flowList)
        {
            @* Console.WriteLine($"Id: {person.Id}, Name: {person.Name}, Age: {person.Age}"); *@
            @* string json = JsonSerializer.Serialize(person);
Console.WriteLine(json); // This requires Client class to have a proper ToString() override *@
        }

    }

    private async Task DeleteLastFlow()
    {
        IMagicQuery<Bills> query = await _MagicDb.Query<Bills>();

        // Get all flows fresh from DB
        var allFlows = await query.ToListAsync();

        var lastItem = allFlows.LastOrDefault();

        if (lastItem != null)
        {
            await query.DeleteAsync(lastItem);
        }

        await GetAllInvoice(); // Refresh your UI list
    }




