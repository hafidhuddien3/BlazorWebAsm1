@inject IMagicIndexedDb _MagicDb
@page "/home-button"


<button @onclick="AddPerson">Add Person</button>
<button @onclick="GetPerson">Get Person</button>

@code {
    private async Task AddPerson()
    {
        IMagicQuery<Client> personQuery = await _MagicDb.Query<Client>();
        await personQuery.AddAsync(new Client { Name = "John Doe", Age = 30 });
        Console.WriteLine("finish add");
    }

    private async Task GetPerson()
    {
        IMagicQuery<Client> personQuery = await _MagicDb.Query<Client>();
        var personList = await personQuery.ToListAsync();

        foreach (var person in personList)
        {
            Console.WriteLine($"Id: {person.Id}, Name: {person.Name}, Age: {person.Age}");
            @* string json = JsonSerializer.Serialize(person);
            Console.WriteLine(json); // This requires Client class to have a proper ToString() override *@
        }

    }

}
