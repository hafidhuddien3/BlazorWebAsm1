@page "/home-button"
@using TG.Blazor.IndexedDB
@inject IndexedDBManager IndexedDbManager

<h1>Hello, world!</h1>
<p>Welcome to your new app.</p>

<button @onclick="AddInitialEntry">Add Journal Entry</button>
<button @onclick="GetAll">Get Journal</button>

@code {
    private async Task AddInitialEntry()
    {
        try
        {
            await IndexedDbManager.AddRecord(new StoreRecord<JournalEntry>
            {
                Storename = "JournalEntries",
                Data = new JournalEntry
                {
                    Id = Guid.NewGuid().ToString(),
                    Date = DateTime.Today,
                    Description = "Initial capital"
                }
            });

            Console.WriteLine("✅ Journal entry added successfully.");

            var results = await IndexedDbManager.GetRecords<JournalEntry>("JournalEntries");
            @* Console.WriteLine("✅ Journal: ", results); *@
            Console.WriteLine($"✅ Journal count: {results.Count}");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error adding journal entry: {ex.Message}");
        }
    }

    private async Task GetAll(){
         var results = await IndexedDbManager.GetRecords<JournalEntry>("JournalEntries");
        Console.WriteLine("✅ Journal: ", results);
    }
}


