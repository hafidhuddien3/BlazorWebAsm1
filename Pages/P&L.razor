@inject IMagicIndexedDb _MagicDb
@inject IJSRuntime JS
@page "/profit-and-loss"
@{
    decimal runningTotal = 0;
}

<h1>Profit and Lost</h1>
<h5>(Revenue - Expense)</h5>

@if (pnl == null || pnl.Count == 0)
{
    @* <div class="text-center" style="background-color: red; color: white;">
No Record</div> *@
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Total Revenue</th>
            <th>Total Expense</th>
            <th>Net Profit</th>
        </tr>
    </thead>
    <tbody>


        @foreach (var item in pnl ?? [])
        {
            <tr>
                <td>@item?.totalRevenue.ToString("N0")</td>
                <td>@item?.totalExpense.ToString("N0")</td>
                <td>@item?.netProfitAndLoss.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>
@if (pnl == null || pnl.Count == 0)
{
    <div class="text-center mb-3">
        No Record</div>
}

<br />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning mt-3">@errorMessage</div>
}

@code {

    private string? VendorId = "";
    private DateTime? JournalLineDate; // | DATETIME | Tanggal invoice dibuat |
    private DateTime? DueDate;
    private decimal TotalAmount;
    private List<ProfitAndLoss> pnl = new List<ProfitAndLoss>();
    private string? Status = "";//| Status | VARCHAR(50) | Status invoice (e.g. Pending, Paid, Overdue) |
    private string? errorMessage;
    List<JournalLines> JournalLines = new List<JournalLines>();

    protected override async Task OnInitializedAsync()
    {
        // Code to run when component initializes (sync)
        await GetAllJournalLine();
    }

    private async Task GetAllJournalLine()
    {

        IMagicQuery<JournalLines> Query = await _MagicDb.Query<JournalLines>();
        var allItems = await Query.ToListAsync();
        var revenueList = allItems.Where(x => x.AccountType == AccountType.Revenue).ToList();

        JournalLines = revenueList;
        var totalRevenue = revenueList.Sum(x => x.Credit ?? 0 - x.Debit ?? 0);

        var expenseList = allItems.Where(x => x.AccountType == AccountType.Expense).ToList();

        @* JournalLines = expenseList; *@
        var totalExpense = expenseList.Sum(x => x.Debit ?? 0 - x.Credit ?? 0);

        var profitAndLoss = totalRevenue - totalExpense;
        Console.WriteLine("totalRevenue: " + totalRevenue);
        Console.WriteLine("totalExpense: " + totalExpense);
        Console.WriteLine("Proofit and Loss: " + profitAndLoss);

        pnl = new List<ProfitAndLoss>
{
new ProfitAndLoss
{
totalRevenue=totalRevenue,
totalExpense=totalExpense,
netProfitAndLoss= profitAndLoss
}

};

        foreach (var flow in revenueList)
        {
            @* Console.WriteLine($"Id: {person.Id}, Name: {person.Name}, Age: {person.Age}"); *@
            @* string json = JsonSerializer.Serialize(person);
            Console.WriteLine(json); // This requires Client class to have a proper ToString() override *@
        }

    }


    class ProfitAndLoss()
    {
        public decimal totalRevenue { get; set; }
        public decimal totalExpense { get; set; }
        public decimal netProfitAndLoss { get; set; }
    }

}