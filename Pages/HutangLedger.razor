@inject IMagicIndexedDb _MagicDb
@inject IJSRuntime JS
@page "/hutang"
@{
    decimal runningTotal = 0;
}

<h1>Hutang Ledger</h1>

@if (JournalLines == null || JournalLines.Count == 0)
{
    @* <div class="text-center" style="background-color: red; color: white;">
No Record</div> *@
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Journal Description</th>
            <th>Account</th>
            <th>AccountType</th>
            <th>Debit</th>
            <th>Credit</th>
            <th>Saldo</th>
        </tr>
    </thead>
    <tbody>


        @foreach (var item in JournalLines)
        {
        runningTotal += item?.Credit??0 - item?.Debit??0;
            <tr>
                <td>@item.Date</td>
                <td>@item.JournalDescription</td>
                <td>@item.Description</td>
                <td>@item.AccountType</td>
                <td>@item.Debit?.ToString("N0")</td>
                <td>@item.Credit?.ToString("N0")</td>
                <td>@runningTotal.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>
@if (JournalLines == null || JournalLines.Count == 0)
{
    <div class="text-center mb-3">
        No Record</div>
}

<br />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning mt-3">@errorMessage</div>
}

