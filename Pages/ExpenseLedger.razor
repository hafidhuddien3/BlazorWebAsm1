@inject IMagicIndexedDb _MagicDb
@inject IJSRuntime JS
@page "/expense"
@{
    decimal runningTotal = 0;
}

<h1>Expense Ledger</h1>

@if (JournalLines == null || JournalLines.Count == 0)
{
    @* <div class="text-center" style="background-color: red; color: white;">
No Record</div> *@
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Journal Description</th>
            <th>Account</th>
            <th>AccountType</th>
            <th>Debit</th>
            <th>Credit</th>
            <th>Saldo</th>
        </tr>
    </thead>
    <tbody>


        @foreach (var item in JournalLines)
        {
            runningTotal += item?.Debit ?? 0 - item?.Credit ?? 0;
            <tr>
                <td>@item.Date</td>
                <td>@item.JournalDescription</td>
                <td>@item.Description</td>
                <td>@item.AccountType</td>
                <td>@item.Debit?.ToString("N0")</td>
                <td>@item.Credit?.ToString("N0")</td>
                <td>@runningTotal.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>
@if (JournalLines == null || JournalLines.Count == 0)
{
    <div class="text-center mb-3">
        No Record</div>
}

<br />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning mt-3">@errorMessage</div>
}

@code {

    private string? VendorId = "";
    private DateTime? JournalLineDate; // | DATETIME | Tanggal invoice dibuat |
    private DateTime? DueDate;
    private decimal TotalAmount;
    private string? Status = "";//| Status | VARCHAR(50)

    @* private string? email; *@

    private string? errorMessage;
    List<JournalLines> JournalLines = new List<JournalLines>();

    protected override async Task OnInitializedAsync()
    {
        // Code to run when component initializes (sync)
        await GetAllJournalLine();
    }

    private async Task GetAllJournalLine()
    {

        IMagicQuery<JournalLines> Query = await _MagicDb.Query<JournalLines>();

        var allItems = await Query.ToListAsync();
        var flowList = allItems.Where(x => x.AccountType == AccountType.Expense).ToList();

        JournalLines = flowList;
        @* Console.WriteLine("personQuery:"); *@
        foreach (var flow in flowList)
        {
            @* Console.WriteLine($"Id: {person.Id}, Name: {person.Name}, Age: {person.Age}"); *@
            @* string json = JsonSerializer.Serialize(person);
            Console.WriteLine(json); // This requires Client class to have a proper ToString() override *@
        }

    }

}