@inject IMagicIndexedDb _MagicDb
@inject IJSRuntime JS
@page "/balance-sheet"
@{
    decimal runningTotal = 0;
}

<h1>Balance Sheet</h1>
<h5>(Asset = Liability + Equity)</h5>

@if (pnl == null || pnl.Count == 0)
{
    @* <div class="text-center" style="background-color: red; color: white;">
No Record</div> *@
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Asset</th>
            <th>Liability + Equity</th>
            @* <th>Net Profit</th> *@
        </tr>
    </thead>
    <tbody>


        @foreach (var item in pnl ?? [])
        {
            <tr>
                <td>@item?.asset.ToString("N0")</td>
                <td>@(item?.liability.ToString("N0")+" + "+item?.equity.ToString("N0")+" = "+(item?.liability+item?.equity)?.ToString("N0"))</td>
            </tr>
        }
    </tbody>
</table>
@if (pnl == null || pnl.Count == 0)
{
    <div class="text-center mb-3">
        No Record</div>
}

<br />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning mt-3">@errorMessage</div>
}

@code {

    private string? VendorId = "";
    private DateTime? JournalLineDate; // | DATETIME | Tanggal invoice dibuat |
    private DateTime? DueDate;
    private decimal TotalAmount;
    private List<BalanceSheet> pnl = new List<BalanceSheet>();
    private string? Status = "";//| Status | VARCHAR(50) | Status invoice (e.g. Pending, Paid, Overdue) |

    @* private string? email; *@

    private string? errorMessage;
    protected override async Task OnInitializedAsync()
    {
        // Code to run when component initializes (sync)
        await GetAllJournalLine();
    }

    // Or async version
    @* protected override async Task OnInitializedAsync()
{
await LoadDataAsync();
} *@


    private async Task GetAllJournalLine()
    {

        IMagicQuery<JournalLines> Query = await _MagicDb.Query<JournalLines>();
        var allItems = await Query.ToListAsync();

        var assetList = allItems.Where(x => x.AccountType == AccountType.Asset).ToList();
        var totalAsset = assetList.Sum(x => x.Debit ?? 0 - x.Credit ?? 0);

        var liabilityList = allItems.Where(x => x.AccountType == AccountType.Liability).ToList();
        var totalLiability = liabilityList.Sum(x => x.Credit ?? 0 - x.Debit ?? 0);

        var equityList = allItems.Where(x => x.AccountType == AccountType.Equity).ToList();
        var totalEquity = equityList.Sum(x => x.Credit ?? 0 - x.Debit ?? 0);

        var totalEquitySum = totalAsset - totalLiability;

        pnl = new List<BalanceSheet>
{
new BalanceSheet
{
asset=totalAsset,
liability=totalLiability,
equity= totalEquitySum+totalEquity
}

};
    }


    class BalanceSheet()
    {
        public decimal asset { get; set; }
        public decimal liability { get; set; }
        public decimal equity { get; set; }
    }

}