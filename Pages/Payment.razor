<table class="table table-striped">
    <thead>
        <tr>
            <th>PaymentMethod</th>
            <th>PaymentDate</th>
            <th>Amount</th>
            @* <th>Status</th> *@
        </tr>
    </thead>
    <tbody>


        @foreach (var item in Payments)
        {
            @*
