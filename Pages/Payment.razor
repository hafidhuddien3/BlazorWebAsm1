@inject IMagicIndexedDb _MagicDb
@inject IJSRuntime JS
@page "/payment"
@{
    decimal runningTotal = 0;
}

<h1>Payment</h1>

@if (Payments == null || Payments.Count == 0)
{
    @* <div class="text-center" style="background-color: red; color: white;">
No Record</div> *@
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Customer/Vendor</th>
            <th>PaymentDate</th>
            <th>Amount</th>
        </tr>
    </thead>
    <tbody>


        @foreach (var item in Payments)
        {
            <tr>
                <td>@(item.Customer != null ? ("Customer: "+(item.Customer??"not found")) : ("Vendor: "+(item.Vendor??"not found")))</td>
                <td>@item.PaymentDate</td>
                <td>@item.Amount?.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>
@if (Payments == null || Payments.Count == 0)
{
    <div class="text-center mb-3">
        No Record</div>
}

<br />
<div class="text-center">
</div>
<div class="text-center">
    <br>
</div>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning mt-3">@errorMessage</div>
}

@code {

    private string? PaymentMethod = "";
    private DateTime? PaymentDate; // | DATETIME | Tanggal Payment dibuat |
    private DateTime? DueDate;
    private decimal TotalAmount;
    private string? Status = "";//| Status | VARCHAR(50) | Status Payment (e.g. Pending, Paid, Overdue) |
    private string? errorMessage;
    List<PaymentViewModel> Payments = new List<PaymentViewModel>();

    protected override async Task OnInitializedAsync()
    {
        await GetAllPayment();
    }

    private async Task AddFlow()
    {
        if (string.IsNullOrWhiteSpace(PaymentMethod) || TotalAmount == 0)
        {
            @* await JS.InvokeVoidAsync("alert", "Please complete form"); *@
            errorMessage = "⚠️ Please complete the form.";
            return;
        }
        TotalAmount = Math.Abs(TotalAmount);

        errorMessage = null;

        Payments? newPayment = new Payments
        {
            PaymentMethod = PaymentMethod,
            PaymentDate = DateTime.Now, // | DATETIME | Tanggal Payment dibuat |
            Amount = TotalAmount,
            InvoiceId = "???",
            BillId = "???",
            CreatedAt = DateTime.Now,
        };

        IMagicQuery<Payments> query = await _MagicDb.Query<Payments>();
        await query.AddAsync(newPayment);

        PaymentMethod = null;
        TotalAmount = 0;
        await GetAllPayment();
    }

    public class PaymentViewModel
    {
        public int PaymentId { get; set; }
        public decimal? Amount { get; set; }
        public DateTime? PaymentDate { get; set; }
        public string? Customer { get; set; }
        public string? Vendor { get; set; }
    }

    private async Task GetAllPayment()
    {
        // Fetch Payments
        var paymentQuery = await _MagicDb.Query<Payments>();
        var payments = await paymentQuery.ToListAsync();

        // Fetch Invoices
        var invoiceQuery = await _MagicDb.Query<Invoices>();
        var invoices = await invoiceQuery.ToListAsync();

        // Fetch Bills
        var billQuery = await _MagicDb.Query<Bills>();
        var bills = await billQuery.ToListAsync();

        // Perform left join
        IEnumerable<PaymentViewModel>? joined = from p in payments
                                                join i in invoices on p.InvoiceId equals i.Id.ToString() into piGroup
                                                from i in piGroup.DefaultIfEmpty()
                                                join b in bills on p.BillId equals b.Id.ToString() into pbGroup
                                                from b in pbGroup.DefaultIfEmpty()
                                                select new PaymentViewModel
                                                {
                                                    PaymentId = p.Id,
                                                    Amount = p.Amount,
                                                    PaymentDate = p.PaymentDate,
                                                    Customer = i?.CustomerId,
                                                    Vendor = b?.VendorId
                                                };

        Payments = joined.ToList();

        // Optional: debug output
        @* foreach (var item in CombinedPayments)
        {
            Console.WriteLine($"PaymentId: {item.PaymentId}, Amount: {item.Amount}, Invoice: {item.InvoiceNumber}, Bill: {item.BillReference}");
        } *@
        }

    // Property to hold the result
    private List<object> CombinedPayments = new();


    private async Task DeleteLastFlow()
    {
        IMagicQuery<Payments> query = await _MagicDb.Query<Payments>();

        // Get all flows fresh from DB
        var allFlows = await query.ToListAsync();

        var lastItem = allFlows.LastOrDefault();

        if (lastItem != null)
        {
            await query.DeleteAsync(lastItem);
        }

        await GetAllPayment(); // Refresh your UI list
    }

}