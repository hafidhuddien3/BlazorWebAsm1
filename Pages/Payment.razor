        TotalAmount = Math.Abs(TotalAmount);

        errorMessage = null;

        @* public DateTime? PaymentDate { get; set; }     // Tanggal pembayaran dilakukan                      
    public decimal? Amount { get; set; }  // Jumlah uang yang dibayarkan                       
    public string? PaymentMethod { get; set; }  // Metode pembayaran (Cash, Bank, Transfer)          
    public string? InvoiceId { get; set; } // Relasi ke invoice (jika pembayaran dari customer) |
    public string? BillId { get; set; } // Relasi ke bill (jika pembayaran ke vendor) *@


        Payments? newPayment = new Payments
        {
            PaymentMethod = PaymentMethod,
            PaymentDate = DateTime.Now, // | DATETIME | Tanggal Payment dibuat |
            Amount = TotalAmount,
            InvoiceId = "???",
            BillId = "???",
            CreatedAt = DateTime.Now,
        };

        IMagicQuery<Payments> query = await _MagicDb.Query<Payments>();
        await query.AddAsync(newPayment);

        PaymentMethod = null;
        TotalAmount = 0;
        await GetAllPayment();
    }

    public class PaymentViewModel
    {
        public int PaymentId { get; set; }
        public decimal? Amount { get; set; }
        public DateTime? PaymentDate { get; set; }
        public string? Customer { get; set; }
        public string? Vendor { get; set; }
    }



    private async Task GetAllPayment()
    {
        // Fetch Payments
        var paymentQuery = await _MagicDb.Query<Payments>();
        var payments = await paymentQuery.ToListAsync();

        // Fetch Invoices
        var invoiceQuery = await _MagicDb.Query<Invoices>();
        var invoices = await invoiceQuery.ToListAsync();

        // Fetch Bills
        var billQuery = await _MagicDb.Query<Bills>();
        var bills = await billQuery.ToListAsync();

        // Perform left join
        IEnumerable<PaymentViewModel>? joined = from p in payments
                                                join i in invoices on p.InvoiceId equals i.Id.ToString() into piGroup
                                                from i in piGroup.DefaultIfEmpty()
                                                join b in bills on p.BillId equals b.Id.ToString() into pbGroup
                                                from b in pbGroup.DefaultIfEmpty()
                                                select new PaymentViewModel
                                                {
                                                    PaymentId = p.Id,
                                                    Amount = p.Amount,
                                                    PaymentDate = p.PaymentDate,
                                                    Customer = i?.CustomerId,
                                                    Vendor = b?.VendorId
                                                };

        // Optional: assign to a property for display
        Payments = joined.ToList();

        // Optional: debug output
        @* foreach (var item in CombinedPayments)
    {
        Console.WriteLine($"PaymentId: {item.PaymentId}, Amount: {item.Amount}, Invoice: {item.InvoiceNumber}, Bill: {item.BillReference}");
    } *@
    }

    // Property to hold the result
    private List<object> CombinedPayments = new();


    private async Task DeleteLastFlow()
    {
        IMagicQuery<Payments> query = await _MagicDb.Query<Payments>();

        // Get all flows fresh from DB
        var allFlows = await query.ToListAsync();

        var lastItem = allFlows.LastOrDefault();

        if (lastItem != null)
        {
            await query.DeleteAsync(lastItem);
        }

        await GetAllPayment(); // Refresh your UI list
    }




