@if (Payments == null || Payments.Count == 0)
{
    <div class="text-center mb-3">
        No Record</div>
}

<div style="display: flex; gap: 10px;">
    <InputText @bind-Value="PaymentMethod" placeholder="PaymentMethod" class="form-control" />
    <InputNumber @bind-Value="TotalAmount" placeholder="Amount" class="form-control" />
</div>

<br />
<div class="text-center">
    <button class="btn btn-primary me-2" @onclick="AddFlow">Add Payment</button>
    @* <button class="btn btn-primary me-2" @onclick="AddMinusFlow">Minus Cash -</button> *@
</div>
<div class="text-center">
    <br>
    <button class="btn btn-success" @onclick="DeleteLastFlow">Delete Last</button>
</div>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning mt-3">@errorMessage</div>
}

@code {

    private string? PaymentMethod = "";
    private DateTime? PaymentDate; // | DATETIME | Tanggal Payment dibuat |
    private DateTime? DueDate;
    private decimal TotalAmount;
    private string? Status = "";//| Status | VARCHAR(50) | Status Payment (e.g. Pending, Paid, Overdue) |

    @* private string? email; *@

    private string? errorMessage;
    List<Payments> Payments = new List<Payments>();

    protected override async Task OnInitializedAsync()
    {
        // Code to run when component initializes (sync)
        @* LoadData(); *@
        await GetAllPayment();
    }

    // Or async version
    @* protected override async Task OnInitializedAsync()
{
await LoadDataAsync();
} *@


    private async Task AddFlow()
    {
        if (string.IsNullOrWhiteSpace(PaymentMethod) || TotalAmount == 0)
        {
            @* await JS.InvokeVoidAsync("alert", "Please complete form"); *@
            errorMessage = "⚠️ Please complete the form.";
            return;
        }
        TotalAmount = Math.Abs(TotalAmount);

        errorMessage = null;

            @* public DateTime? PaymentDate { get; set; }     // Tanggal pembayaran dilakukan                      
    public decimal? Amount { get; set; }  // Jumlah uang yang dibayarkan                       
    public string? PaymentMethod { get; set; }  // Metode pembayaran (Cash, Bank, Transfer)          
    public string? InvoiceId { get; set; } // Relasi ke invoice (jika pembayaran dari customer) |
    public string? BillId { get; set; } // Relasi ke bill (jika pembayaran ke vendor) *@


        Payments? newPayment = new Payments
            {
                PaymentMethod = PaymentMethod,
                PaymentDate = DateTime.Now, // | DATETIME | Tanggal Payment dibuat |
                Amount = TotalAmount,
                InvoiceId = "???",
                BillId = "???",
                CreatedAt = DateTime.Now,
            };

        IMagicQuery<Payments> query = await _MagicDb.Query<Payments>();
        await query.AddAsync(newPayment);

        PaymentMethod = null;
        TotalAmount = 0;
        await GetAllPayment();
    }



    private async Task GetAllPayment()
    {

        IMagicQuery<Payments> Query = await _MagicDb.Query<Payments>();
        var flowList = await Query.ToListAsync();
        Payments = flowList;
        @* Console.WriteLine("personQuery:"); *@
        foreach (var flow in flowList)
        {
            @* Console.WriteLine($"Id: {person.Id}, Name: {person.Name}, Age: {person.Age}"); *@
            @* string json = JsonSerializer.Serialize(person);
Console.WriteLine(json); // This requires Client class to have a proper ToString() override *@
        }

    }

    private async Task DeleteLastFlow()
    {
        IMagicQuery<Payments> query = await _MagicDb.Query<Payments>();

        // Get all flows fresh from DB
        var allFlows = await query.ToListAsync();

        var lastItem = allFlows.LastOrDefault();

        if (lastItem != null)
        {
            await query.DeleteAsync(lastItem);
        }

        await GetAllPayment(); // Refresh your UI list
    }




